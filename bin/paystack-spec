#!/usr/bin/env ruby
# frozen_string_literal: true

# Compares this SDK against Paystack's official OpenAPI spec
# (https://github.com/PaystackOSS/openapi, dist/paystack.yaml).
#
#   bin/paystack-spec audit                 # coverage + endpoints the SDK calls that the spec lacks
#   bin/paystack-spec missing [Tag]         # spec operations the SDK does not implement (optionally one tag)
#   bin/paystack-spec show METHOD /path     # what the spec says about one operation
#   bin/paystack-spec update                # refresh the pinned spec from upstream and show what changed
#   bin/paystack-spec info                  # which upstream commit the pinned spec is
#   bin/paystack-spec docs-fetch            # download Paystack's docs mirror pages (not committed)
#   bin/paystack-spec docs-diff [Tag]       # compare those pages with the spec, operation by operation
#
# The spec is pinned in spec/fixtures/paystack_openapi.yaml so every command, and CI,
# works offline and gives the same answer until the pin is deliberately updated.
#
# Options:
#   --spec PATH   use another copy of paystack.yaml instead of the pinned one
#   --docs DIR    where the docs pages are kept (default: tmp/docs-snapshots/mirror, which is gitignored)
#
# The spec gives paths, methods, required fields and enums. It does NOT replace
# the prose docs (https://paystack.com/docs/api/) for behaviour such as rate
# limits or idempotency. See .claude/skills/paystack-api-workflow/SKILL.md.

require "net/http"
require "uri"
require "yaml"
require "tmpdir"
require "optparse"
require "cgi"

SPEC_URL = "https://raw.githubusercontent.com/PaystackOSS/openapi/main/dist/paystack.yaml"
RESOURCES_GLOB = File.expand_path("../lib/paystack_sdk/resources/*.rb", __dir__)
HTTP_METHODS = %w[get post put delete patch].freeze

# `@connection.get("/path/...")`: the first string argument, whose #{interpolations} may contain
# quotes of their own, as in "/transfer/#{escape_path(code, name: "code")}".
PATH_PATTERN = /@connection\.(get|post|put|delete)\(\s*"((?:#\{[^}]*\}|[^"])*)"/

spec_path = nil
docs_dir = File.expand_path("../tmp/docs-snapshots/mirror", __dir__)
OptionParser.new { |o|
  o.on("--spec PATH") { |v| spec_path = v }
  o.on("--docs DIR") { |v| docs_dir = File.expand_path(v) }
}.parse!

DOCS_MIRROR = "https://docs-v2.production.paystack.co/docs/api"
DOCS_NON_REFERENCE = %w[authentication rate-limits pagination errors webhook-events].freeze
EXCEPTIONS_FILE = File.expand_path("../spec/support/paystack_contract_exceptions.yml", __dir__)
DOCS_ONLY_FILE = File.expand_path("../spec/fixtures/docs_only_operations.yml", __dir__)

PINNED = File.expand_path("../spec/fixtures/paystack_openapi.yaml", __dir__)
PINNED_SOURCE = File.expand_path("../spec/fixtures/paystack_openapi.source.yml", __dir__)
SPEC_REPO = "PaystackOSS/openapi"
SPEC_PATH = "dist/paystack.yaml"

def load_spec(path)
  YAML.safe_load_file(path || PINNED, aliases: true)
end

def http_get(url)
  response = Net::HTTP.get_response(URI(url))
  abort "GET #{url} failed (HTTP #{response.code})" unless response.is_a?(Net::HTTPSuccess)
  response.body
end

def normalize(path)
  path = "/#{path}" unless path.start_with?("/")
  path.gsub(/\{[^}]+\}/, "{x}")
end

def operations(spec)
  spec["paths"].each_with_object({}) do |(path, item), ops|
    item.each do |verb, op|
      next unless HTTP_METHODS.include?(verb)
      ops[[verb.upcase, normalize(path)]] = {path: path, op: op, shared: item["parameters"] || []}
    end
  end
end

# Operations the docs describe and the spec lacks, which the SDK implements deliberately.
def docs_only_operations
  @docs_only_operations ||= YAML.safe_load_file(DOCS_ONLY_FILE).to_h do |entry|
    verb, path = entry.fetch("operation").split(" ", 2)
    [[verb, normalize(path)], entry]
  end
end

def implemented
  Dir[RESOURCES_GLOB].each_with_object({}) do |file, found|
    File.read(file).scan(PATH_PATTERN) do |verb, path|
      found[[verb.upcase, normalize(path.gsub(/#\{[^}]+\}/, "{x}").sub(/\?.*/, ""))]] = File.basename(file)
    end
  end
end

def resolve(spec, node)
  while node.is_a?(Hash) && node["$ref"]
    node = node["$ref"].delete_prefix("#/").split("/").reduce(spec) { |cur, part| cur.fetch(part) }
  end
  node
end

# Flattens allOf so required fields declared in a base schema are not missed.
def flatten(spec, schema)
  schema = resolve(spec, schema)
  return {"required" => [], "properties" => {}} unless schema.is_a?(Hash)

  parts = (schema["allOf"] || []).map { |s| flatten(spec, s) }
  parts << {"required" => schema["required"] || [], "properties" => schema["properties"] || {}}
  {
    "required" => parts.flat_map { |p| p["required"] }.uniq,
    "properties" => parts.reduce({}) { |acc, p| acc.merge(p["properties"]) }
  }
end

def body_schema(spec, op)
  content = resolve(spec, op["requestBody"] || {}).fetch("content", {})
  schema = content.values.first&.fetch("schema", nil)
  schema && flatten(spec, schema)
end

# --- docs mirror

def docs_slug(tag)
  tag.downcase.tr(" ", "-")
end

# One entry per operation on a docs page: method, path and the parameters it lists. The page's
# "optional" label marks optional parameters; unlabelled ones are required unless they state a default.
def parse_docs_page(html)
  html.split(/(?=<h2 id=")/).select { |part| part.start_with?(%(<h2 id=")) }.filter_map do |section|
    text = CGI.unescapeHTML(section.gsub(/<[^>]+>/, " "))
    verb = text[/-X\s+(GET|POST|PUT|DELETE|PATCH)\b/, 1] or next
    path = text[%r{https://api\.paystack\.co(/[^\s"']*)}, 1] or next
    title = CGI.unescapeHTML(section[/<\/svg><\/span><\/a>(.*?)<\/h2>/m, 1].to_s).strip
    params = []
    section.split(/(?=<section><h3>)/).each do |part|
      where = {"Path Parameters" => "path", "Query Parameters" => "query", "Body Parameters" => "body"}[part[/<h3>([^<]+)<\/h3>/, 1]] or next
      part.scan(/<div class="api-param">(.*?)<\/div><\/div>(?=<div class="api-param">|<\/div><\/section>)/m) do |(block)|
        name = CGI.unescapeHTML(block[/api-param__name">([^<]*)</, 1].to_s)
        next if name.empty?
        params << {in: where, name: name, type: block[/api-param__type">([^<]*)</, 1].to_s.downcase,
                   required: where == "path" || !(block.include?("api-param__use") || block =~ /not specified|defaults? to|default value/i), use: block[/api-param__use">([^<]*)</, 1]}
      end
    end
    # the docs write path variables as `:id`; the spec as `{id}`
    {verb: verb, path: path.sub(/\?.*/, "").gsub(%r{/:([A-Za-z_]+)}, '/{\1}'), title: title, params: params}
  end
end

TYPE_GROUPS = {"integer" => "integer", "int" => "integer", "number" => "number", "float" => "number", "double" => "number",
               "string" => "string", "boolean" => "boolean", "bool" => "boolean", "array" => "array", "object" => "object"}.freeze

def type_group(type)
  TYPE_GROUPS[type.to_s.downcase.strip]
end

def spec_params(spec, entry)
  found = []
  (entry[:shared] + (entry[:op]["parameters"] || [])).each do |param|
    param = resolve(spec, param)
    next unless %w[path query].include?(param["in"])
    found << {in: param["in"], name: param["name"], type: resolve(spec, param["schema"] || {})["type"], required: !!param["required"] || param["in"] == "path"}
  end
  if (body = body_schema(spec, entry[:op]))
    body["properties"].each do |name, prop|
      found << {in: "body", name: name, type: resolve(spec, prop)["type"], required: body["required"].include?(name)}
    end
  end
  found
end

def recorded_exceptions
  @recorded_exceptions ||= YAML.safe_load_file(EXCEPTIONS_FILE)
end

def recorded?(verb, path, location, name)
  key = "#{verb} #{path}"
  recorded_exceptions.any? { |e| e["operation"] == key && e["in"] == location && [e["wire"], e["spec"]].include?(name) }
end

# The key of the spec operation a docs operation describes. Most match on normalized path; some pages
# put a sample id in the URL (`/order/12345`), so fall back to matching segment by segment, a spec
# `{variable}` standing for any docs segment. Unmatched ones keep their own key.
# Whether a docs-only operation is one the SDK records in docs_only_operations.yml. A `{variable}` in the
# registry matches any docs segment, since the docs sometimes put a sample id in the URL.
def registered_docs_only?(verb, docs_path)
  segments = docs_path.split("/")
  docs_only_operations.values.any? do |entry|
    entry_verb, path = entry["operation"].split(" ", 2)
    parts = path.split("/")
    entry_verb == verb && parts.size == segments.size &&
      parts.zip(segments).all? { |part, segment| part.start_with?("{") || part == segment }
  end
end

def match_key(docs_op, ops)
  key = [docs_op[:verb], normalize(docs_op[:path])]
  return key if ops.key?(key)

  segments = docs_op[:path].split("/")
  ops.keys.find do |verb, path|
    parts = path.split("/")
    verb == docs_op[:verb] && parts.size == segments.size &&
      parts.zip(segments).all? { |spec_part, docs_part| spec_part == "{x}" || spec_part == docs_part }
  end || key
end

# Returns the findings for one operation: [kind, text, recorded?]
def diff_operation(verb, spec_path, spec_ps, docs_op)
  findings = []
  docs_ps = docs_op[:params]
  spec_by = spec_ps.group_by { |p| [p[:in], p[:name]] }.transform_values(&:first)
  docs_by = docs_ps.group_by { |p| [p[:in], p[:name]] }.transform_values(&:first)

  (docs_by.keys - spec_by.keys).each do |loc, name|
    next if loc == "path"
    # a path variable renamed in the docs shows up as a name difference, handled below
    findings << ["docs-only", "#{loc} `#{name}` is in the docs, not the spec", recorded?(verb, spec_path, loc, name)]
  end
  (spec_by.keys - docs_by.keys).each do |loc, name|
    next if loc == "path"
    findings << ["spec-only", "#{loc} `#{name}` is in the spec, not the docs", recorded?(verb, spec_path, loc, name)]
  end
  (docs_by.keys & spec_by.keys).each do |loc, name|
    d, s = docs_by[[loc, name]], spec_by[[loc, name]]
    dt, st = type_group(d[:type]), type_group(s[:type])
    if dt && st && dt != st
      findings << ["type", "#{loc} `#{name}`: docs say #{d[:type]}, spec says #{s[:type]}", recorded?(verb, spec_path, loc, name)]
    end
    # The docs label only optional parameters, so an unlabelled one is read as required, unless its
    # description gives a default ("If not specified, we use ..."), as on `perPage` and `page`.
    if d[:required] != s[:required]
      findings << ["required", "#{loc} `#{name}`: docs say #{d[:required] ? "required" : "optional"}, spec says #{s[:required] ? "required" : "optional"}", recorded?(verb, spec_path, loc, name)]
    end
  end
  docs_path_names = docs_op[:path].scan(/\{([^}]+)\}/).flatten
  spec_path_names = spec_path.scan(/\{([^}]+)\}/).flatten
  if docs_path_names != spec_path_names
    findings << ["path", "path variable is `#{docs_path_names.join(", ")}` in the docs and `#{spec_path_names.join(", ")}` in the spec", false]
  end
  findings
end

spec = load_spec(spec_path)
ops = operations(spec)
ours = implemented

case ARGV.shift
when "audit"
  covered = ours.keys & ops.keys
  puts "Spec operations: #{ops.size}   SDK covers: #{covered.size} (#{(100.0 * covered.size / ops.size).round}%)"
  documented_only = ours.keys & docs_only_operations.keys
  drift = ours.keys - ops.keys - docs_only_operations.keys
  if drift.empty?
    puts "Every endpoint the SDK calls exists in the spec#{" or is a documented-only operation" unless documented_only.empty?}."
    unless documented_only.empty?
      puts "Documented-only operations the SDK implements (in #{File.basename(DOCS_ONLY_FILE)}, not in the spec): #{documented_only.size}"
      documented_only.each { |verb, path| puts "  #{verb} #{docs_only_operations[[verb, path]]["operation"].split(" ", 2).last}   (#{ours[[verb, path]]})" }
    end
  else
    puts "\nSDK calls these but the spec has no such operation (check the docs; likely a bug):"
    drift.each { |verb, path| puts "  #{verb} #{path}   (#{ours[[verb, path]]})" }
  end
  puts "\nCoverage by tag:"
  ops.group_by { |_, v| v[:op]["tags"]&.first || "?" }.sort.each do |tag, list|
    done = list.count { |key, _| ours.key?(key) }
    puts format("  %-26s %2d / %2d", tag, done, list.size)
  end
  exit(drift.empty? ? 0 : 1)
when "missing"
  tag = ARGV.shift
  ops.each do |(verb, _), v|
    next if ours.key?([verb, normalize(v[:path])])
    next if tag && v[:op]["tags"]&.first&.casecmp?(tag) == false
    puts format("%-7s %-55s %s", verb, v[:path], v[:op]["summary"])
  end
when "show"
  verb, path = ARGV.shift&.upcase, ARGV.shift
  abort "usage: bin/paystack-spec show METHOD /path" unless verb && path
  entry = ops[[verb, normalize(path)]] or abort "No such operation in the spec: #{verb} #{path}"
  op = entry[:op]
  puts "#{verb} #{entry[:path]}  (#{op["tags"]&.first})"
  puts op["summary"]
  puts op["description"].to_s.strip unless op["description"].to_s.strip.empty?
  schema = body_schema(spec, op)
  if schema
    puts "\nBody fields (* = required):"
    schema["properties"].each do |name, prop|
      prop = resolve(spec, prop)
      mark = schema["required"].include?(name) ? "*" : " "
      enum = prop["enum"] ? "  enum: #{prop["enum"].join(", ")}" : ""
      puts format(" %s %-24s %-8s %s%s", mark, name, prop["type"], prop["description"].to_s.strip.tr("\n", " ")[0, 110], enum)
    end
  end
  params = (op["parameters"] || []).map { |p| resolve(spec, p) }
  unless params.empty?
    puts "\nParameters:"
    params.each { |p| puts format(" %s %-8s %-20s %s", p["required"] ? "*" : " ", p["in"], p["name"], p["description"].to_s.strip.tr("\n", " ")[0, 110]) }
  end
  puts "\nSDK: #{ours[[verb, normalize(path)]] || "not implemented"}"
when "docs-fetch"
  require "fileutils"
  FileUtils.mkdir_p(docs_dir)
  index = http_get("#{DOCS_MIRROR}/")
  slugs = index.scan(%r{href="/docs/api/([a-z0-9-]+)/?"}).flatten.uniq - DOCS_NON_REFERENCE
  slugs.each do |slug|
    response = Net::HTTP.get_response(URI("#{DOCS_MIRROR}/#{slug}/"))
    if response.code == "200"
      File.write(File.join(docs_dir, "#{slug}.html"), response.body)
      puts format("  %-28s saved (%d KB)", slug, response.body.size / 1024)
    else
      puts format("  %-28s skipped (HTTP %s)", slug, response.code)
    end
    sleep 1
  end
  puts "Saved #{slugs.size} pages to #{docs_dir}. These files are not committed."
when "docs-diff"
  only = ARGV.shift&.then { |tag| docs_slug(tag) }
  files = Dir[File.join(docs_dir, "*.html")].sort.select { |f| only.nil? || File.basename(f, ".html") == only }
  abort "No docs pages in #{docs_dir}. Run bin/paystack-spec docs-fetch first." if files.empty?
  totals = Hash.new(0)
  seen = []
  files.each do |file|
    docs_ops = parse_docs_page(File.read(file)).to_h { |o| [match_key(o, ops), o] }
    lines = []
    docs_ops.each do |key, docs_op|
      entry = ops[key]
      if entry.nil?
        if registered_docs_only?(key[0], docs_op[:path])
          lines << "  #{key[0]} #{docs_op[:path]}   (#{docs_op[:title]})\n      operation docs-only, implemented   [recorded in #{File.basename(DOCS_ONLY_FILE)}]"
          totals["recorded"] += 1
        else
          lines << "  #{key[0]} #{docs_op[:path]}   (#{docs_op[:title]})\n      operation docs-only: the spec has no such operation"
          totals["operation"] += 1
        end
        next
      end
      seen << key
      found = diff_operation(key[0], entry[:path], spec_params(spec, entry), docs_op)
      next if found.empty?
      lines << "  #{key[0]} #{entry[:path]}   (#{entry[:op]["summary"]})"
      found.each do |kind, text, known|
        totals[known ? "recorded" : kind] += 1
        lines << "      #{kind.ljust(9)} #{text}#{"   [recorded]" if known}"
      end
    end
    puts "#{File.basename(file, ".html")}  (#{docs_ops.size} docs operations)"
    puts(lines.empty? ? "  no differences" : lines)
    puts
  end
  unless only
    missing = ops.keys - seen
    puts "Spec operations on no docs page (#{missing.size})"
    missing.each { |verb, path| puts "  #{verb} #{ops[[verb, path]][:path]}   (#{ops[[verb, path]][:op]["summary"]})" }
    totals["operation"] += missing.size
    puts
  end
  puts "Summary: " + (totals.empty? ? "no differences" : totals.sort.map { |k, v| "#{v} #{k}" }.join(", "))
  puts "Differences are leads, not verdicts. Settle each with the canonical page or a live test-mode probe, then record it in spec/support/paystack_contract_exceptions.yml."
when "info"
  source = YAML.safe_load_file(PINNED_SOURCE)
  puts "Pinned spec: #{source["repo"]}/#{source["path"]} @ #{source["commit"]} (committed #{source["committed_at"]})"
  puts "Operations: #{ops.size}"
when "update"
  require "json"
  latest = JSON.parse(http_get("https://api.github.com/repos/#{SPEC_REPO}/commits?path=#{SPEC_PATH}&per_page=1")).first
  sha = latest.fetch("sha")
  current = YAML.safe_load_file(PINNED_SOURCE)["commit"]
  if sha == current
    puts "Already pinned to the latest upstream commit (#{sha[0, 7]})."
    exit
  end
  body = http_get("https://raw.githubusercontent.com/#{SPEC_REPO}/#{sha}/#{SPEC_PATH}")
  fresh = YAML.safe_load(body, aliases: true)
  before = ops.keys
  after = operations(fresh).keys
  File.write(PINNED, body)
  File.write(PINNED_SOURCE, <<~YML)
    # Where spec/fixtures/paystack_openapi.yaml comes from. Refresh it with: bin/paystack-spec update
    repo: #{SPEC_REPO}
    path: #{SPEC_PATH}
    commit: #{sha}
    committed_at: "#{latest.dig("commit", "committer", "date")}"
    license: MIT
  YML
  puts "Pinned #{current[0, 7]} -> #{sha[0, 7]}. Operations: #{before.size} -> #{after.size}"
  (after - before).each { |verb, path| puts "  added   #{verb} #{path}" }
  (before - after).each { |verb, path| puts "  removed #{verb} #{path}" }
  puts "Review the diff, then run the specs and bin/paystack-spec audit."
else
  abort "usage: bin/paystack-spec audit | missing [Tag] | show METHOD /path | info | update | docs-fetch | docs-diff [Tag]   [--spec PATH] [--docs DIR]"
end
